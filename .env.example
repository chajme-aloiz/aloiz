# Zkopírujte do .env.local (na počítači) nebo vložte do Vercel > Settings > Environment Variables.
# Tyto hodnoty nikdy neposílejte do chatu ani do GitHubu.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Console > API Keys
ANTHROPIC_API_KEY=
# Volitelné: jiný model Claude (výchozí claude-sonnet-5-5)
CLAUDE_MODEL=

# Přeposílání e-mailů (Postmark > Inbound). Adresa, kterou rodiče uvidí v aplikaci:
NEXT_PUBLIC_INBOUND_ADDRESS=xxxx@inbound.postmarkapp.com
# Tajné heslo, které se přidá na konec webhook adresy: https://<app>/api/inbound?key=...
INBOUND_SECRET=

# Volitelné: jen tyto e-maily smí používat čtení přes AI (oddělené čárkou). Prázdné = kdokoli přihlášený.
ALLOWED_EMAILS=
