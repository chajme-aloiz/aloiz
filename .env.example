# Zkopírujte do .env.local (na počítači) nebo vložte do Vercel > Settings > Environment Variables.
# Tyto hodnoty nikdy neposílejte do chatu ani do GitHubu.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Console > API Keys
ANTHROPIC_API_KEY=
# Volitelné: jiný model Claude (výchozí claude-sonnet-5-5)
CLAUDE_MODEL=

# Přeposílání e-mailů (Postmark > Inbound). Adresa, kterou rodiče uvidí v aplikaci:
NEXT_PUBLIC_INBOUND_ADDRESS=xxxx@inbound.postmarkapp.com
# Tajné heslo, které se přidá na konec webhook adresy: https://<app>/api/inbound?key=...
INBOUND_SECRET=

# Volitelné: jen tyto e-maily smí používat čtení přes AI (oddělené čárkou). Prázdné = kdokoli přihlášený.
ALLOWED_EMAILS=

# Upozornění (ranní souhrn, připomínky). Hodnoty vyrobí stránka https://<app>/api/push/setup
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Heslo pro plánovač v Supabase (pg_cron), který každých 5 minut volá /api/push/cron
CRON_SECRET=

# Volitelné: kontaktní e-mail zobrazený na stránce /soukromi
CONTACT_EMAIL=

# WhatsApp (Meta for Developers > aplikace > WhatsApp > API Setup)
# Číslo Aloizu jen číslicemi, s předvolbou (např. 15551234567). Zobrazí se v aplikaci.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Phone number ID (ne samotné číslo)
WHATSAPP_PHONE_ID=
# Trvalý přístupový token (System user v Meta Business)
WHATSAPP_TOKEN=
# App secret (App settings > Basic), Aloiz jím ověřuje, že zpráva opravdu přišla od Meta
WHATSAPP_APP_SECRET=
# Libovolné heslo, které vyplníte i ve Webhooku v Meta (Verify token)
WHATSAPP_VERIFY_TOKEN=
